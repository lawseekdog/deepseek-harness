@@ -0,0 +1,215 @@
+import { Type } from "typebox";
+import { describe, expect, it } from "vitest";
+import { stream as streamCompletions } from "../src/api/openai-completions.ts";
+import { stream } from "../src/api/openai-responses.ts";
+import { transformMessages } from "../src/api/transform-messages.ts";
+import type { Api, AssistantMessage, Model } from "../src/types.ts";
+import { estimateMessageTokens } from "../src/utils/estimate.ts";
+import {
+	parseToolCallArguments,
+	requireToolCallArguments,
+	serializeToolCallArguments,
+} from "../src/utils/tool-arguments.ts";
+import { validateToolArguments } from "../src/utils/validation.ts";
+
+const model: Model<"openai-responses"> = {
+	id: "test-model",
+	name: "test-model",
+	provider: "test",
+	api: "openai-responses",
+	baseUrl: "https://provider.invalid/v1",
+	reasoning: false,
+	input: ["text"],
+	cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+	contextWindow: 10000,
+	maxTokens: 1000,
+};
+
+function functionResponse(rawArguments: string, delta = '{"different":true}', argumentsDone = rawArguments): Response {
+	const item = { type: "function_call", id: "fc_a", call_id: "call_a", name: "inspect", arguments: rawArguments };
+	const events = [
+		{ type: "response.created", response: { id: "resp_a" } },
+		{ type: "response.output_item.added", output_index: 0, item: { ...item, arguments: "" } },
+		{ type: "response.function_call_arguments.delta", output_index: 0, item_id: "fc_a", delta },
+		{ type: "response.function_call_arguments.done", output_index: 0, item_id: "fc_a", arguments: argumentsDone },
+		{ type: "response.output_item.done", output_index: 0, item },
+		{ type: "response.completed", response: { id: "resp_a", status: "completed", output: [item] } },
+	];
+	return new Response(
+		events.map((event, sequence_number) => `data: ${JSON.stringify({ ...event, sequence_number })}\n\n`).join(""),
+		{
+			status: 200,
+			headers: { "content-type": "text/event-stream" },
+		},
+	);
+}
+
+async function receive(raw: string, delta?: string, argumentsDone?: string): Promise<AssistantMessage> {
+	return stream(
+		model,
+		{ messages: [{ role: "user", content: "inspect", timestamp: 0 }] },
+		{
+			apiKey: "test-key",
+			fetch: async () => functionResponse(raw, delta, argumentsDone),
+			maxRetries: 0,
+		},
+	).result();
+}
+
+const invalid = [
+	'{"item":{"count":1}',
+	'{"text":"line\nbreak"}',
+	'{"path":"C:\\q"}',
+	'{"item":{"count":1} "other":2}',
+	"",
+	"null",
+	"[1,2]",
+	"42",
+	'"text"',
+];
+
+describe("Responses raw function arguments", () => {
+	it.each(["error", "aborted"] as const)("omits %s messages before object-protocol validation", async (stopReason) => {
+		const message = await receive("{");
+		message.stopReason = stopReason;
+		expect(transformMessages([message], { ...model, api: "anthropic-messages" })).toEqual([]);
+	});
+	it.each(invalid)("retains %j through SDK streaming and next-request history", async (raw) => {
+		const message = await receive(raw);
+		expect(message.stopReason).toBe("toolUse");
+		const call = message.content[0];
+		expect(call).toEqual({
+			type: "toolCall",
+			id: "call_a|fc_a",
+			name: "inspect",
+			arguments: undefined,
+			rawArguments: raw,
+		});
+		if (call.type !== "toolCall") throw new Error("Expected tool call");
+		expect(() =>
+			validateToolArguments({ name: "inspect", description: "inspect", parameters: Type.Object({}) }, call),
+		).toThrow("not a complete JSON object");
+		let sent: { input: Array<{ type?: string; arguments?: string }> } | undefined;
+		const replayed = JSON.parse(JSON.stringify(message)) as AssistantMessage;
+		const next = stream(
+			model,
+			{
+				messages: [
+					replayed,
+					{
+						role: "toolResult",
+						toolCallId: call.id,
+						toolName: call.name,
+						content: [{ type: "text", text: "INVALID_ARGS" }],
+						isError: true,
+						timestamp: 1,
+					},
+				],
