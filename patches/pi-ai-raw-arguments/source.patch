diff --git a/packages/ai/src/utils/tool-arguments.ts b/packages/ai/src/utils/tool-arguments.ts
new file mode 100644
index 00000000..9422528d
--- /dev/null
+++ b/packages/ai/src/utils/tool-arguments.ts
@@ -0,0 +1,29 @@
+import type { ToolCall } from "../types.ts";
+
+/** Strictly parse a JSON object without repairing incomplete or malformed provider text. */
+export function parseToolCallArguments(raw: string): Record<string, unknown> | undefined {
+	let parsed: unknown;
+	try {
+		parsed = JSON.parse(raw);
+	} catch (error) {
+		if (!(error instanceof SyntaxError)) throw error;
+		return undefined;
+	}
+	return typeof parsed === "object" && parsed !== null && !Array.isArray(parsed)
+		? (parsed as Record<string, unknown>)
+		: undefined;
+}
+
+/** Return an executable object or reject an incomplete, malformed, or non-object call. */
+export function requireToolCallArguments(toolCall: ToolCall): Record<string, unknown> {
+	const args =
+		toolCall.rawArguments === undefined ? toolCall.arguments : parseToolCallArguments(toolCall.rawArguments);
+	if (args === undefined) throw new Error(`Tool "${toolCall.name}" arguments are not a complete JSON object`);
+	return args;
+}
+
+/** Serialize a function call, preserving provider text byte-for-byte when it is available. */
+export function serializeToolCallArguments(toolCall: ToolCall): string {
+	if (toolCall.rawArguments !== undefined) return toolCall.rawArguments;
+	return JSON.stringify(requireToolCallArguments(toolCall));
+}
